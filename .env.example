# Skra Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Required
# =============================================================================

# Secret key for JWT signing and encryption (must be 32+ characters)
SKRA_SECRET_KEY=your-super-secret-key-must-be-at-least-32-characters

# PostgreSQL password
POSTGRES_PASSWORD=your-postgres-password

# =============================================================================
# Environment
# =============================================================================

# Runtime environment: development, testing, production
SKRA_ENVIRONMENT=development

# Enable debug mode
SKRA_DEBUG=false

# =============================================================================
# Database
# =============================================================================

# Database URLs (override for production)
# SKRA_DATABASE_URL=postgresql+asyncpg://skra:password@pgbouncer:5432/skra
# SKRA_DATABASE_URL_SYNC=postgresql://skra:password@pgbouncer:5432/skra

# =============================================================================
# Redis
# =============================================================================

# Redis URL (override for production)
# SKRA_REDIS_URL=redis://valkey:6379/0
# Disable only for proof deployments that intentionally run without Redis.
# SKRA_RATE_LIMITING_ENABLED=true

# =============================================================================
# CORS
# =============================================================================

# Allowed CORS origins (comma-separated)
SKRA_CORS_ORIGINS=http://localhost:8080

# =============================================================================
# JWT Settings
# =============================================================================

# Access token expiration in minutes (default: 30)
SKRA_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token expiration in days (default: 7)
SKRA_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# MFA Settings
# =============================================================================

# Enable MFA requirement for password authentication
SKRA_MFA_ENABLED=true

# TOTP issuer name for authenticator apps
SKRA_MFA_TOTP_ISSUER=Skra

# =============================================================================
# WebAuthn/Passkeys
# =============================================================================

# WebAuthn Relying Party ID (domain without port)
SKRA_WEBAUTHN_RP_ID=localhost

# WebAuthn Relying Party display name
SKRA_WEBAUTHN_RP_NAME=Skra

# WebAuthn expected origin (comma-separated for multiple)
SKRA_WEBAUTHN_ORIGIN=http://localhost:8080

# =============================================================================
# S3/Garage Storage
# =============================================================================

# Garage S3 access credentials — mode auto-selection (no setting needed):
# legacy pair present => import (existing deployments, unchanged); pair
# absent => managed (new deployments mint natively via POST /v1/key and
# distribute through the garage-creds volume); partial pair => fail closed.
# Explicit GARAGE_KEY_MODE=managed|import always wins. Managed needs no
# preshared key material. To restore a backup or adopt a pre-existing key,
# set GARAGE_KEY_MODE=import plus the legacy pair (backup-restore only):
# key ID must be `GK` + 24 hex chars, secret 64 hex chars.
# Generate key ID with: printf 'GK%s\n' "$(openssl rand -hex 12)"
# Generate secret with: openssl rand -hex 32
# Admin token for Garage's admin HTTP API — must match admin_token in config/garage.toml
# Generate with: openssl rand -hex 32
GARAGE_ADMIN_TOKEN=your-admin-token

# GARAGE_KEY_MODE=managed
# GARAGE_KEY_NAME=bifrost-docs-key
# Restore-only legacy pair (GARAGE_KEY_MODE=import):
# GARAGE_ACCESS_KEY_ID=your-access-key-id
# GARAGE_SECRET_ACCESS_KEY=your-secret-access-key

# S3 bucket name
SKRA_S3_BUCKET=skra

# =============================================================================
# Azure Blob Storage (Azure + Neon proof)
# =============================================================================

# Set to azure_blob to use Azure Storage instead of S3/Garage.
# SKRA_STORAGE_BACKEND=azure_blob

# Either provide a connection string or an account URL + account key.
# SKRA_AZURE_STORAGE_CONNECTION_STRING=
# SKRA_AZURE_STORAGE_ACCOUNT_URL=https://youraccount.blob.core.windows.net
# SKRA_AZURE_STORAGE_ACCOUNT_KEY=
# SKRA_AZURE_BLOB_CONTAINER=attachments
# SKRA_AZURE_BLOB_SAS_EXPIRY=600
# SKRA_AZURE_BLOB_DOWNLOAD_SAS_EXPIRY=3600

# =============================================================================
# OpenAI (for vector search)
# =============================================================================

# OpenAI API key (optional - search works without it, just no semantic search)
SKRA_OPENAI_API_KEY=
SKRA_OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# =============================================================================
# Default Admin User (Optional)
# =============================================================================

# If set, creates this user on startup (useful for development)
# SKRA_DEFAULT_USER_EMAIL=admin@example.com
# SKRA_DEFAULT_USER_PASSWORD=admin123

# =============================================================================
# Debugging (Development Only)
# =============================================================================

# Enable debugpy for VS Code attachment
ENABLE_DEBUG=false
