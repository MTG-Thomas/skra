# Skra Client - Development Container Image
# Installs dependencies only - all code comes from volume mounts
# Prevents stale code and build cache issues

FROM node:20-slim

# Vite listens on unprivileged 8080 (same container port as production nginx),
# so no extra capabilities are needed for the non-root node user.

WORKDIR /app
RUN chown node:node /app

# Copy package files and install dependencies as non-root user
COPY package*.json ./
USER node
RUN npm ci

# Don't copy source code - it comes from volume mounts in docker-compose.dev.yml
# This prevents any risk of stale built code overwriting live source

# Expose port 8080 to match the production nginx container port
EXPOSE 8080

# Start Vite dev server with HMR
# --host 0.0.0.0 allows external connections (needed for Docker)
# --port 8080 matches the production container port, so the base compose
# port mapping works for both targets; host port stays localhost:8080
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "8080"]
